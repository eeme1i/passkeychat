{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply useful-database --local",
    "db:migrate:remote": "wrangler d1 migrations apply useful-database --remote",
    "db:cleanup:local": "node scripts/cleanup-db.mjs --local",
    "db:cleanup:remote": "node scripts/cleanup-db.mjs --remote",
    "invite": "node scripts/create-invite.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.2",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.110.0"
  }
}
